# Empty template only. Run python tools/setup_local.py to generate NEW local credentials.
APP_NAME=AI Mercado Manager
ENVIRONMENT=development
DATABASE_URL=
POSTGRES_PASSWORD=
RESTORE_CHECK_PASSWORD=
APP_ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Must be HTTPS and exactly match the DevCenter configuration. Use an HTTPS tunnel/domain in development.
ML_REDIRECT_URI=https://YOUR-HTTPS-DOMAIN/api/v1/integrations/mercadolivre/callback
ML_SITE_ID=MLB
MARKETPLACE_WRITE_ENABLED=false

# No paid AI calls unless explicitly enabled
AI_ENABLED=false
# Optional legacy password; prefer creating your operator access through /login
APP_ACCESS_TOKEN=

# Background read-only sync (single API worker); frequency and pause are saved through the panel.
AUTO_SYNC_WORKER_ENABLED=true

# Private single-operator access, enabled by default
AUTH_REQUIRED=true
ALLOWED_HOSTS=localhost,127.0.0.1,::1
API_DOCS_ENABLED=false

# Optional HTTPS origin for a trusted proxy/tunnel. Keep private deployment values out of Git.
PUBLIC_BASE_URL=
